# LOCAL DEVELOPMENT: copy to .env.local. The browser calls the local API directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5087

# VERCEL DEMO: configure this server-side variable in Vercel instead.
# BACKEND_API_URL=https://YOUR-RAILWAY-SERVICE.up.railway.app
# Do NOT set NEXT_PUBLIC_API_BASE_URL on Vercel. The deployed browser uses relative
# /api requests, which Next.js rewrites to the backend while preserving same-origin cookies.
